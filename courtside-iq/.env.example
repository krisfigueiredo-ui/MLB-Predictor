# ---- Data providers (leave blank for DEMO mode) ----
BALLDONTLIE_API_KEY=
ODDS_API_KEY=
SPORTSDATAIO_API_KEY=
ODDS_API_REGIONS=us
ODDS_API_BOOKMAKERS=draftkings,fanduel,betmgm,williamhill_us

# ---- COURTSIDE AI (Claude) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_EFFORT=medium

# ---- Assets: base URL of a LICENSED logo CDN ({slug}.svg). Leave blank to use original crests.
LICENSED_LOGO_BASE_URL=

# ---- Runtime ----
LIVE_POLL_SECONDS=20
ODDS_POLL_SECONDS=300
MONTE_CARLO_SIMS=10000
RANDOM_SEED=20261118
# Demo mode: load the committed dataset (backend/data/demo_snapshot) into an empty database.
USE_DEMO_SNAPSHOT=true
# Protects mutating admin endpoints (retrain, tune, refresh, asset registry) when set.
ADMIN_TOKEN=
POSTGRES_PASSWORD=courtside
# Optional: MLflow experiment tracking
MLFLOW_TRACKING_URI=
